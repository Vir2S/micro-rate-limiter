APP_NAME=rate-limiter
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0

# Захист доступу до сервісу (shared secret). Якщо пусто — сервіс відкритий.
AUTH_TOKEN=change-me

# Політики лімітів
POLICY_PATH=/app/policies.json

# Префікс ключів у Redis
KEY_PREFIX=rl

# Якщо клієнт не передав key, беремо з X-Api-Key / X-Service-Id / IP
FALLBACK_TO_IP=true
TRUST_X_FORWARDED_FOR=true
